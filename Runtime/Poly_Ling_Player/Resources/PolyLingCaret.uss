/* PolyLingCaret.uss
 * 全 TextField のキャレット(カーソル)色を白にする。
 * root(UIDocument.rootVisualElement) に一度だけ付与し、全子孫の入力要素へ一元適用する。
 * キャレット色は --unity-cursor-color でのみ設定可能（C# style.* 不可）。 */
.unity-base-text-field__input {
    --unity-cursor-color: rgb(255, 255, 255);
}

/* TreeView（オブジェクトリスト）の展開/折り畳み矢印。
 * 組み込みの checkmark 画像は既定色が暗く、行がハイライトされていないと
 * 背景に埋もれて見えない。tint を明るくして常時視認できるようにする。
 * -unity-background-image-tint-color は C# の style.* から設定できないため USS で行う。 */
.unity-tree-view__item-toggle > .unity-toggle__input > .unity-toggle__checkmark {
    -unity-background-image-tint-color: rgb(205, 205, 205);
}

.unity-tree-view__item-toggle:hover > .unity-toggle__input > .unity-toggle__checkmark {
    -unity-background-image-tint-color: rgb(255, 255, 255);
}

/* Foldout（右ペインの各折り畳み見出し）の矢印も同じ理由で明るくする。 */
.unity-foldout__toggle > .unity-toggle__input > .unity-toggle__checkmark {
    -unity-background-image-tint-color: rgb(205, 205, 205);
}

/* ドロップダウンで開くメニュー本体（DropdownField を押したときに出る一覧）。
 *
 * 【なぜ USS でしかできないか】
 * PlayerLayoutRoot.ApplyDarkTheme は Build 直後に一度だけ走り、そのとき存在する
 * 要素へインラインで色を入れる。メニューは「押した瞬間」に UIToolkit が作り、
 * しかもパネル最上位のコンテナへ差し込まれるので、ApplyDarkTheme は決して届かない。
 * 結果、既定の明るい配色（白背景）のまま残っていた。
 * 後から作られる要素に効かせられるのはクラス名で当てる USS だけなので、ここに置く。
 * このシートは root ではなくパネル最上位へ貼ること（PolyLingPlayerViewerCore 側）。*/
.unity-base-dropdown__container-outer {
    background-color: rgb(51, 51, 51);
    border-left-color: rgb(90, 90, 90);
    border-right-color: rgb(90, 90, 90);
    border-top-color: rgb(90, 90, 90);
    border-bottom-color: rgb(90, 90, 90);
}

.unity-base-dropdown__container-inner {
    background-color: rgb(51, 51, 51);
}

.unity-base-dropdown__item {
    background-color: rgb(51, 51, 51);
    color: rgb(255, 255, 255);
}

.unity-base-dropdown__item:hover {
    background-color: rgb(64, 90, 140);
}

.unity-base-dropdown__label {
    color: rgb(255, 255, 255);
}

.unity-base-dropdown__separator {
    background-color: rgb(90, 90, 90);
}

.unity-base-dropdown__checkmark {
    -unity-background-image-tint-color: rgb(255, 255, 255);
}
